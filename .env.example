# =========================================================
# Clerk Authentication
# =========================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Google OAuth (configured in Clerk dashboard, no env needed here)
# Email + Google login are enabled through Clerk's dashboard.

# =========================================================
# Supabase
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =========================================================
# Razorpay
# =========================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =========================================================
# Resend (ticket confirmation emails)
# =========================================================
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Project926 Tickets <tickets@yourdomain.com>
# Optional: replies to ticket confirmation emails go here instead of RESEND_FROM_EMAIL
RESEND_REPLY_TO=

# =========================================================
# App
# =========================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================
# Spring Boot backend (Phase H)
# =========================================================
# Server-only — the browser never calls Spring directly; every call is
# proxied through a Next.js Server Component, Server Action, or Route
# Handler, which attaches the signed-in user's Clerk session token. See
# lib/backend/client.ts.
PROJECT926_BACKEND_URL=http://localhost:8080
