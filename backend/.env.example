# =========================================================
# Project926 backend — development environment variables
# =========================================================
# Copy to a local, gitignored file (e.g. .env.dev) and load it into your
# shell/IDE run configuration before starting the app with `-Dspring
# -boot.run.profiles=dev` (the default). Never commit real values.
#
# DATABASE: must point at the DEVELOPMENT Supabase project only
# (memdvuuszsistdjckcfp.supabase.co). Never the original production project.
# Find the direct/pooled Postgres connection details in the Supabase
# dashboard under Project Settings -> Database.
SUPABASE_DB_HOST=db.memdvuuszsistdjckcfp.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# CLERK: JWT validation (Spring Security OAuth2 resource server).
# Defaults in application-dev.yml already point at this project's Clerk dev
# instance (derived from the public NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY already
# used by the Next.js app) — only override if using a different Clerk
# environment.
CLERK_JWK_SET_URI=https://solid-grouper-15.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://solid-grouper-15.clerk.accounts.dev

# RAZORPAY: same test-mode keys the Next.js app already uses (see the
# repo root .env.local's RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET/
# NEXT_PUBLIC_RAZORPAY_KEY_ID). Never use live keys in development.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: only needed if the public key id differs from RAZORPAY_KEY_ID
# (it doesn't, in this project's existing setup). Defaults to RAZORPAY_KEY_ID.
RAZORPAY_PUBLIC_KEY_ID=

# App
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
